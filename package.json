{
  "name": "lugano-in-anteprima",
  "version": "0.1.0",
  "description": "Lugano in anteprima — pianifica e prova una giornata a Lugano in un modellino illustrato",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "API_PORT=8787 node --watch-path=src/server --watch-path=src/shared --disable-warning=ExperimentalWarning --import tsx src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --import tsx src/server/index.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "data:perimeter": "tsx scripts/geo/01-perimeter.ts",
    "data:osm": "bash scripts/data/fetch-osm.sh",
    "data:terrain": "tsx scripts/geo/03-fetch-terrain.ts",
    "data:map": "node --max-old-space-size=8192 --import tsx scripts/geo/04-build-map.ts",
    "data:graphs": "node --max-old-space-size=8192 --import tsx scripts/geo/05-build-graphs.ts",
    "data:gtfs": "bash scripts/data/fetch-gtfs.sh && tsx scripts/transit/01-import-gtfs.ts",
    "data:transit": "node --max-old-space-size=8192 --import tsx scripts/transit/02-build-transit.ts",
    "data:catalog": "node --max-old-space-size=8192 --import tsx scripts/catalog/build-catalog.ts",
    "data:build": "npm run data:map && npm run data:graphs && npm run data:transit && npm run data:catalog",
    "data:all": "npm run data:perimeter && npm run data:osm && npm run data:terrain && npm run data:terrain-ch && npm run data:gtfs && npm run data:build",
    "test:all": "vitest run && playwright test",
    "data:terrain-ch": "node --max-old-space-size=8192 --import tsx scripts/geo/06-swissalti3d.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@hono/node-server": "^2.1.1",
    "fast-xml-parser": "^5.11.1",
    "geokdbush": "^2.1.0",
    "hono": "^4.13.9",
    "kdbush": "^4.1.0",
    "luxon": "^3.7.2",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^6.11.2",
    "opening_hours": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tinyqueue": "^3.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "csv-parse": "^7.0.3",
    "geojson-vt": "^5.0.2",
    "geotiff": "^3.0.5",
    "osmtogeojson": "^3.0.0-beta.5",
    "pngjs": "^7.0.0",
    "polylabel": "^2.1.0",
    "proj4": "^2.22.0",
    "simplify-js": "^1.2.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vt-pbf": "^3.1.3",
    "yauzl": "^3.4.0"
  }
}
