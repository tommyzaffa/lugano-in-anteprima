# Lugano in anteprima — configurazione (copiare in .env e compilare solo ciò che serve).
# Nessun segreto va versionato. Tutte le chiavi restano lato server: il browser non le riceve mai.
# Senza nessuna variabile l'app parte in MODALITÀ DEMO (pianificatore deterministico, meteo e eventi dimostrativi).

# --- Server -------------------------------------------------------------------
# Porta del server (in produzione serve app, API, tile e glifi sulla stessa porta).
PORT=8787
# In sviluppo l'API gira su API_PORT (Vite su 5173 inoltra /api qui).
API_PORT=8787
HOST=127.0.0.1
# Percorso del database SQLite (programmi salvati, condivisioni, segnalazioni, statistiche aggregate).
DB_PATH=data/db/lugano.sqlite
# Token del pannello editoriale (/admin). Se vuoto, all'avvio ne viene generato uno temporaneo e stampato nel terminale.
ADMIN_TOKEN=

# --- AI (facoltativa) -----------------------------------------------------------
# anthropic | none. Con "none" le proposte vengono dal pianificatore deterministico (dichiarato come tale, mai «AI live»).
AI_PROVIDER=none
# Chiave API Anthropic (oppure un profilo `ant auth login` sulla macchina del server).
ANTHROPIC_API_KEY=
# Modello (default consigliato: claude-opus-5).
ANTHROPIC_MODEL=claude-opus-5
# Limiti: token massimi per risposta, timeout (ms), tentativi, tetto giornaliero complessivo di token.
AI_MAX_OUTPUT_TOKENS=8000
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=1
AI_DAILY_TOKEN_BUDGET=400000

# --- Meteo ------------------------------------------------------------------------
# open-meteo (previsioni reali, gratuite solo per uso non commerciale) | demo (fixture) | none
WEATHER_PROVIDER=demo
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- Trasporti in tempo reale (facoltativo, da verificare) -----------------------
# ojp | none. Richiede una chiave personale dall'API Manager di opentransportdata.swiss.
TRANSIT_LIVE_PROVIDER=none
OJP_URL=https://api.opentransportdata.swiss/ojp20
OJP_API_KEY=
OJP_REQUESTOR_REF=LuganoInAnteprima_dev

# --- Pianificatore ----------------------------------------------------------------------
# Margini configurabili (secondi): cambio fra corse e anticipo in fermata.
PLANNER_MIN_CHANGE_SEC=120
PLANNER_BOARD_MARGIN_SEC=120
PLANNER_TIMEOUT_MS=20000

# --- Protezione dai consumi ---------------------------------------------------------
RATE_LIMIT_PLAN_PER_MIN=12
RATE_LIMIT_GENERAL_PER_MIN=600

# --- Dati -----------------------------------------------------------------------------
DATA_DIR=data
# Dataset GTFS da scaricare con `npm run data:gtfs` (anno orario).
GTFS_DATASET=timetable-2026-gtfs2020
